EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=gym-images

# Phone-only dev OTP (123456 + @app.local bridge). Email ALWAYS uses Supabase — never hardcoded.
EXPO_PUBLIC_ENABLE_DEV_PHONE_AUTH=true
# Legacy alias (phone only): EXPO_PUBLIC_ENABLE_DEV_AUTH=true
# Allow phone dev bridge in EAS preview/production APKs (optional)
EXPO_PUBLIC_ALLOW_PROD_DEV_AUTH=false

# Google OAuth: configure Client ID/Secret in Supabase Dashboard (Authentication → Providers → Google).
# Add redirect URLs in Supabase (Authentication → URL Configuration), e.g.:
#   gymapp://auth/callback
#   exp://127.0.0.1:8081/--/auth/callback   (Expo Go local dev)
#   https://your-domain.com/auth/callback   (web production)
