EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=gym-images

# Phone-only dev OTP (123456 + @app.local bridge). Email ALWAYS uses Supabase — never hardcoded.
EXPO_PUBLIC_ENABLE_DEV_PHONE_AUTH=true
# Legacy alias (phone only): EXPO_PUBLIC_ENABLE_DEV_AUTH=true
# Allow phone dev bridge in EAS preview/production APKs (optional)
EXPO_PUBLIC_ALLOW_PROD_DEV_AUTH=false

# Native Google Sign-In (Android/iOS) — Web OAuth client ID from Google Cloud Console.
# Also add this same Web Client ID in Supabase Dashboard → Authentication → Providers → Google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client ID (recommended for iOS builds)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client ID for Expo config plugin, e.g. com.googleusercontent.apps.123456789
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Web-only OAuth redirect URLs in Supabase (Authentication → URL Configuration), e.g.:
#   https://your-domain.com/auth/callback
